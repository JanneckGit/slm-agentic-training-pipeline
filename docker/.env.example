# docker/.env — read by `docker compose -f docker/docker-compose.yml …`. Compose takes the
# project directory from the compose file, so the real file lives HERE (docker/.env, gitignored),
# not in the repo root. Copy: cp docker/.env.example docker/.env
#
# Optional: every model this pipeline serves is public. A token only lifts Hugging Face
# rate limits / unlocks gated repos. Leave empty to run without one.
HF_TOKEN=

# Optional: vLLM image overrides. Both services default to v0.21.0, pinned by digest in
# docker-compose.yml. Change them only on purpose. tau2 numbers are only comparable on v0.21.
# VLLM_IMAGE      = the `vllm` service (agent / teacher / eval model, port 8000)
# VLLM_USER_IMAGE = the `vllm-user` service (tau2 user simulator, port 8001); kept separate so the
#                   simulator stays fixed while the agent version changes
# VLLM_IMAGE=vllm/vllm-openai:v0.30.0
# VLLM_USER_IMAGE=vllm/vllm-openai:v0.30.0
